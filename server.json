{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.corbinvachal48/agentrender-mcp",
  "title": "AgentRender",
  "description": "URL to screenshot, PDF, or extract for AI agents. Free 150 renders/mo, then $17/mo.",
  "repository": {
    "url": "https://github.com/corbinvachal48/agentrender-mcp",
    "source": "github"
  },
  "websiteUrl": "https://agentrenderapi.com",
  "version": "0.1.2",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "agentrender-mcp",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "AGENTRENDER_API_KEY",
          "description": "AgentRender API key (akr_...). Free, instant, no card: https://agentrenderapi.com/#waitlist (or call the get_free_key tool)",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "AGENTRENDER_BASE_URL",
          "description": "API base URL",
          "isRequired": false,
          "format": "string",
          "default": "https://api.agentrenderapi.com"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.agentrenderapi.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer akr_... API key. Free, instant, no card: https://agentrenderapi.com/#waitlist",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/corbinvachal48/agentrender-mcp/main/assets/logo-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://raw.githubusercontent.com/corbinvachal48/agentrender-mcp/main/assets/logo-192.png",
      "mimeType": "image/png",
      "sizes": [
        "192x192"
      ]
    },
    {
      "src": "https://raw.githubusercontent.com/corbinvachal48/agentrender-mcp/main/assets/logo-64.png",
      "mimeType": "image/png",
      "sizes": [
        "64x64"
      ]
    }
  ]
}
