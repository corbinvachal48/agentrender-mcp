{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.corbinvachal48/agentrender-mcp",
  "description": "URL to screenshot, PDF, or structured extract for AI agents via MCP.",
  "repository": {
    "url": "https://github.com/corbinvachal48/agentrender-mcp",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "agentrender-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "AGENTRENDER_API_KEY",
          "description": "AgentRender API key (akr_\u2026)",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "AGENTRENDER_BASE_URL",
          "description": "API base URL",
          "isRequired": false,
          "format": "string",
          "default": "https://api.agentrenderapi.com"
        }
      ]
    }
  ]
}
