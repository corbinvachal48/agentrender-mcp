{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.corbinvachal48/agentrender-mcp",
  "description": "URL to screenshot, PDF, or structured extract for AI agents via MCP.",
  "repository": {
    "url": "https://github.com/corbinvachal48/agentrender-mcp",
    "source": "github"
  },
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "agentrender-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "AGENTRENDER_API_KEY",
          "description": "AgentRender API key (akr_\u2026)",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "AGENTRENDER_BASE_URL",
          "description": "API base URL",
          "isRequired": false,
          "format": "string",
          "default": "https://api.agentrenderapi.com"
        }
      ]
    }
  ],
  "title": "AgentRender",
  "websiteUrl": "https://agentrenderapi.com",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/corbinvachal48/agentrender-mcp/main/assets/logo-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://raw.githubusercontent.com/corbinvachal48/agentrender-mcp/main/assets/logo-192.png",
      "mimeType": "image/png",
      "sizes": [
        "192x192"
      ]
    },
    {
      "src": "https://raw.githubusercontent.com/corbinvachal48/agentrender-mcp/main/assets/logo-64.png",
      "mimeType": "image/png",
      "sizes": [
        "64x64"
      ]
    }
  ]
}
